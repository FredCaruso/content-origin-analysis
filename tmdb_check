#!/usr/bin/env python3
"""
tmdb_check.py - validacao da credencial TMDB + diagnostico do campo de origem.

Faz duas coisas:
  1. Confirma que o Read Access Token funciona.
  2. Para uma amostra de titulos, imprime os TRES campos de origem lado a lado
     (original_language, origin_country, production_countries) para mostrar
     onde eles discordam -- que e a razao da regra de origem adotada.

Uso:
    python tmdb_check.py

Le o token de um arquivo .env no mesmo diretorio, ou da variavel de
ambiente TMDB_READ_TOKEN.

Somente biblioteca padrao. Nenhuma instalacao necessaria.

Este produto usa a API do TMDB, mas nao e endossado nem certificado pelo TMDB.
"""

import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API = "https://api.themoviedb.org/3"
PAUSE = 0.25  # ~4 req/s, bem abaixo do teto do TMDB

# Amostra escolhida para estressar o campo de origem: producoes Netflix
# nao-inglesas de paises diferentes, mais uma americana como controle.
AMOSTRA = [
    "Squid Game",
    "La Casa de Papel",
    "Alice in Borderland",
    "Lupin",
    "Sacred Games",
    "Stranger Things",
]


def carregar_token():
    token = os.environ.get("TMDB_READ_TOKEN")
    if token and token.strip():
        return token.strip()
    base = os.path.dirname(os.path.abspath(__file__))
    caminho = os.path.join(base, ".env")
    if os.path.exists(caminho):
        with open(caminho, encoding="utf-8") as fh:
            for linha in fh:
                linha = linha.strip()
                if linha.startswith("TMDB_READ_TOKEN"):
                    valor = linha.split("=", 1)[1].strip().strip('"').strip("'")
                    if valor:
                        return valor
    sys.exit(
        "ERRO: TMDB_READ_TOKEN nao encontrado ou vazio.\n"
        "  Crie um arquivo .env nesta pasta com a linha:\n"
        "  TMDB_READ_TOKEN=seu_token_aqui"
    )


def get(caminho, token, **params):
    url = f"{API}{caminho}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {token}", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if e.code == 401:
            sys.exit("ERRO 401: token invalido ou nao autorizado.")
        if e.code == 429:
            sys.exit("ERRO 429: rate limit atingido. Reduza a taxa e tente de novo.")
        sys.exit(f"ERRO HTTP {e.code} em {caminho}: {e.reason}")
    except urllib.error.URLError as e:
        sys.exit(f"ERRO de rede em {caminho}: {e.reason}")


def campos_origem(item, token):
    """Retorna (original_language, origin_country, production_countries)."""
    tipo = item.get("media_type")
    tid = item.get("id")
    detalhe = get(f"/{'tv' if tipo == 'tv' else 'movie'}/{tid}", token)
    time.sleep(PAUSE)
    return (
        detalhe.get("original_language") or "",
        ",".join(detalhe.get("origin_country") or []),
        ",".join(
            c.get("iso_3166_1", "") for c in detalhe.get("production_countries") or []
        ),
    )


def main():
    token = carregar_token()

    print("Validando credencial...", end=" ", flush=True)
    get("/authentication", token)
    print("OK\n")

    cab = (
        f"{'TITULO':<22} {'TIPO':<6} {'orig_lang':<10} "
        f"{'orig_country':<13} {'prod_countries':<16} {'DIVERGE?'}"
    )
    print(cab)
    print("-" * len(cab))

    divergencias = 0
    for titulo in AMOSTRA:
        res = get("/search/multi", token, query=titulo, include_adult="false")
        time.sleep(PAUSE)
        candidatos = [
            r for r in res.get("results", []) if r.get("media_type") in ("tv", "movie")
        ]
        if not candidatos:
            print(f"{titulo:<22} {'--':<6} SEM MATCH")
            continue

        item = candidatos[0]
        lang, orig_c, prod_c = campos_origem(item, token)

        primeiro_prod = prod_c.split(",")[0] if prod_c else ""
        diverge = bool(
            orig_c and primeiro_prod and primeiro_prod not in orig_c.split(",")
        )
        divergencias += diverge

        nome = (item.get("name") or item.get("title") or "?")[:21]
        print(
            f"{nome:<22} {item.get('media_type'):<6} {lang:<10} "
            f"{orig_c:<13} {prod_c[:16]:<16} {'SIM' if diverge else '-'}"
        )

    print("-" * len(cab))
    print(
        f"\nTitulos em que production_countries diverge de origin_country: "
        f"{divergencias}/{len(AMOSTRA)}"
    )
    print("Cada 'SIM' e um titulo que seria classificado no pais errado se o")
    print("pipeline usasse production_countries como criterio primario.")


if __name__ == "__main__":
    main()
